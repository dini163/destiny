# ---------------------------------------------------------------------------
# Destiny environment template. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Backend bind address, read by `python -m app.run` (the container command).
BACKEND_HOST=0.0.0.0
# Keep BACKEND_PORT at 8000 under compose. nginx hardcodes the upstream as
# `proxy_pass http://backend:8000`, whereas the image HEALTHCHECK reads this
# variable — so changing it produces a backend that reports healthy, a frontend
# that starts, and every /api call returning 502. Change it only for a bare
# `python -m app.run`, or edit frontend/nginx.conf to match.
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins (frontend dev server by default).
# The compose stack needs none: nginx serves the SPA and proxies /api same-origin.
CORS_ORIGINS=http://localhost:5173

# Optional: directory containing Swiss Ephemeris DE431 data files (*.se1).
# Leave empty to use the built-in analytical (Moshier) ephemeris, which is real
# astronomy and requires no download. Set it for maximum DE431 precision.
SWEPH_EPHE_PATH=

# ---------------------------------------------------------------------------
# Paid report products (R1/R2/R3, v2.1 §3A) — signed delivery links.
# ---------------------------------------------------------------------------
# HMAC secret that signs report delivery links. The default value below is a
# DEVELOPMENT placeholder: anyone who knows the codebase could forge links with
# it. Set a real random secret in production (e.g. `openssl rand -hex 32`).
REPORT_SECRET=dev-report-secret-change-me
# Delivery-link validity in hours (default 168 = 7 days).
REPORT_LINK_TTL_HOURS=168
