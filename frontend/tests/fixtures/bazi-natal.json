        }
      ],
      "meaning": "文昌与天乙、太极同为贵神之类，主学业文思；本表以日干禄顺数第三辰取之。",
      "source": "《三命通会·论十干禄》禄表·禄前第三辰（《三命通会·卷三》文昌贵别本未采）"
    },
    {
      "name": "羊刃",
      "quality": "凶",
      "checked_from": "日干丙",
      "matches": [
        {
          "position": "day",
          "character": "午",
          "at": "zhi"
        },
        {
          "position": "hour",
          "character": "午",
          "at": "zhi"
        }
      ],
      "meaning": "羊言刚也，刃者取宰割之义；禄过则刃生，功成当退不退则过。甲丙戊庚壬五阳有刃，乙丁己辛癸五阴无刃。",
      "source": "《三命通会·论羊刃》（《渊海子平》作『论阳刃』）"
    },
    {
      "name": "驿马",
      "quality": "中性",
      "checked_from": "申子辰局、寅午戌局",
      "matches": [
        {
          "position": "month",
          "character": "申",
          "at": "zhi"
        }
      ],
      "meaning": "驿马者，三命中发用，喜庆之神。君子遇之常居荣位，小人主丰赡；凡柱中马，若不值空亡、破败、交退、伏神，须荣贵。",
      "source": "《三命通会·论驿马》"
    },
    {
      "name": "华盖",
      "quality": "中性",
      "checked_from": "申子辰局、寅午戌局",
      "matches": [
        {
          "position": "year",
          "character": "辰",
          "at": "zhi"
        }
      ],
      "meaning": "华盖者，喻如宝盖，以三合底处得库谓之。凡人命得华盖，多主孤寡，总贵亦不免孤独，作僧道艺术论。",
      "source": "《三命通会·论将星华盖》"
    },
    {
      "name": "将星",
      "quality": "吉",
      "checked_from": "申子辰局、寅午戌局",
      "matches": [
        {
          "position": "day",
          "character": "午",
          "at": "zhi"
        },
        {
          "position": "hour",
          "character": "午",
          "at": "zhi"
        }
      ],
      "meaning": "将星者，如将札中军也，故以三合中位谓之将星；常欲吉星相扶、贵煞加临乃为吉庆。",
      "source": "《三命通会·论将星华盖》"
    }
  ],
  "ten_god_readings": [
    {
      "ten_god": "劫财",
      "count": 2,
      "positions": [
        "day.zhi(丁)",
        "hour.zhi(丁)"
      ],
      "meaning": "亦名『逆刃』，如乙见甲为劫财。乙以庚为夫，见丙克庚，故克夫；男命则克妻。五阳见五阴为败财，主克妻害子。五阴见五阳为劫财，主破耗、防小人，不克妻。",
      "six_relation": null,
      "source": "《渊海子平·论劫财》"
    },
    {
      "ten_god": "食神",
      "count": 2,
      "positions": [
        "year.zhi(戊)",
        "month.zhi(戊)"
      ],
      "meaning": "食神者，生我财神之谓也；如甲属木，丙属火，名盗气，故谓之『食神』。",
      "six_relation": "食神是男孙",
      "source": "《渊海子平·论食神》"
    },
    {
      "ten_god": "伤官",
      "count": 2,
      "positions": [
        "day.zhi(己)",
        "hour.zhi(己)"
      ],
      "meaning": "伤官者，其验如神。伤官务要伤尽；伤之不尽，官来乘旺，其祸不可胜言。",
      "six_relation": "伤官是女孙及祖母也",
      "source": "《渊海子平·论伤官》"
    },
    {
      "ten_god": "偏财",
      "count": 2,
      "positions": [
        "year.gan",
        "month.zhi(庚)"
      ],
      "meaning": "何谓之偏财？盖阳见阳财，阴见阴财也。然而偏财者，乃众人之财也，只恐兄弟姊妹有夺之，则福不全；若有官星，祸患百出。",
      "six_relation": "偏财是父，乃母之夫星也，亦为偏妻",
      "source": "《渊海子平·论偏财》"
    },
    {
      "ten_god": "七杀",
      "count": 1,
      "positions": [
        "month.zhi(壬)"
      ],
      "meaning": "夫七杀者，亦名偏官，喜身旺合杀、喜制伏、喜阳刃；忌身弱、忌见财，生忌无制。身旺有气为偏官，身弱无制为七杀。",
      "six_relation": "七杀是男",
      "source": "《渊海子平·论七杀》"
    },
    {
      "ten_god": "正官",
      "count": 1,
      "positions": [
        "year.zhi(癸)"
      ],
      "meaning": "夫正官者，甲见辛之类；乃阴见阳为官，阳见阴为鬼，阴阳配合成其道也。大抵要行官旺乡，月令是也。",
      "six_relation": "正官是女",
      "source": "《渊海子平·正官论》"
    },
    {
      "ten_god": "偏印",
      "count": 2,
      "positions": [
        "month.gan",
        "hour.gan"
      ],
      "meaning": "夫倒食者，冲财神之谓也；一名『吞啗煞』。用财神大忌见之，用食神亦忌见之。",
      "six_relation": "偏印偏母及祖父也",
      "source": "《渊海子平·论倒食》"
    },
    {
      "ten_god": "正印",
      "count": 1,
      "positions": [
        "year.zhi(乙)"
      ],
      "meaning": "所谓印？生我者，即印绶也，经曰：『有官无印，即非真官；有印无官，反成其福。』",
      "six_relation": "正印正母",
      "source": "《渊海子平·论印绶》"
    }
  ],
