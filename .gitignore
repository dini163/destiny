# ---------------------------------------------------------------------------
# Destiny — .gitignore
# Covers: OS cruft, editor/IDE files, secrets, Python (lunar-python/pyswisseph/
# skyfield compute layer), Node/frontend build output, logs, temp, local data,
# and the machine-local working materials listed below.
# NOTE: public assets live in assets/ and must stay trackable — do not add
#       broad image/html ignore patterns here.
# ---------------------------------------------------------------------------

# --- Operating system -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editor / IDE -----------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*.swn
*~
.qoder/
.codex/
# WorkBuddy stores session memory and daily work logs here: machine-local
# agent state, not source code. Keep the folder on disk, never track it.
.workbuddy/

# --- Machine-local working materials (never published) ---------------------
# Design drafts, product specs, review evidence, engineering conventions and
# helper scripts stay on disk for local work, but they are internal working
# material and must not appear in the public repository or its history.
/.creative-design/
/design/
/prd/
/scripts/
/docs/
/.gitattributes
/AGENTS.md
# README illustrations live in assets/ (a separate root dir) and stay public.

# --- Local deployment kit (machine-local, never published) -----------------
# deploy-local/ holds the LAN host addresses, deploy scripts and compose
# overlays for the Raspberry Pi / PV Box. Its name is deliberately tool-neutral
# so any agent can use it locally, but it must never reach the public repo.
/deploy-local/

# --- Environment & secrets (never commit credentials) -----------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# --- Python (compute / ephemeris layer) -------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
# Swiss ephemeris large binary data fetched at runtime (keep repo lean)
*.se1
sweph/ephe/*.se1

# --- Node / frontend build output ------------------------------------------
node_modules/
jspm_packages/
bower_components/
.npm/
.npmrc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.out/
.svelte-kit/
.vite/
.parcel-cache/
.cache/
.serverless/
.vercel/
.netlify/
*.tsbuildinfo
# Frontend `src/lib/` is real source code — re-include it (and everything under
# it) so the bare `lib/` Python-artifact rule above does not swallow it.
!frontend/src/lib/
!frontend/src/lib/**
# Same trap for the vitest suite: `frontend/tests/lib/` holds test helpers
# (fixture reader, logic tests) and must be trackable for the same reason.
!frontend/tests/lib/
!frontend/tests/lib/**

# --- Logs & runtime ---------------------------------------------------------
logs/
*.log
run/
*.pid
*.seed
*.pid.lock

# --- Local databases / private user data (E2EE vaults stay off-repo) --------
*.db
*.sqlite
*.sqlite3
*.duckdb
data/local/
/backend/data/local/
IndexedDB/
*.ldif

# --- Temp / scratch ---------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
.cache_tmp/

# --- Test / golden artifacts generated at runtime ---------------------------
tests/golden/.cache/
.golden-cache/

# --- Packaging / archives ---------------------------------------------------
*.zip
*.tar.gz
*.rar

# --- Design-tool source cruft (keep exported png/html, drop editable bins) --
*.psd
*.ai
*.sketch
*.fig
*.xd
# Figma/Stitch export intermediates
*.stitch/

# --- Monorepo build/test extras --------------------------------------------
frontend/coverage/
backend/coverage/
.eslintcache
*.tsbuildinfo
.vite/

# --- Browser-walkthrough screenshots ---------------------------------------
# Verification evidence captured while walking a slice through the browser.
# Kept on disk but never tracked. Narrow and root-anchored so assets/*.png,
# which is published with the README, stays trackable.
/.verify-*.png
/.refix-*.png
